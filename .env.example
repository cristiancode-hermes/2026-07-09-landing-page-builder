# ─── Landing Page Builder ───
# Copy this file to .env and replace with your values

# App
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRES_IN=7d

# Database
DATABASE_PATH=data/db.sqlite
# Neon (PostgreSQL) — uncomment for production
# DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/landing-page-builder?sslmode=require

# Neon Data API (optional — for direct frontend reads)
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_DATABASE_NAME=landing-page-builder

# Public URL base (for published pages)
PUBLIC_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
